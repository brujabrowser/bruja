// Occupancy NavigationController. LoadUrl calls blink::LocalFrame::Navigate
// (WASMBlinker LocalFrameImpl: parse / script / layout / paint). Intern:
// interface:lime.NavigationController.
module lime;

enum PageType {
  NORMAL,
  ERROR_PAGE,
};

struct NavigationState {
  string url;
  string title;
  PageType page_type;
  bool can_go_back;
  bool can_go_forward;
  bool is_main_document_loaded;
};

interface NavigationEventListener {
  // Real Mojo doesn't yet have flow-control response-blocking (that's a
  // NavigationControllerImpl-side discipline -- see WASMLime's frame_impl):
  // callers must ack before the next notification is sent.
  OnNavigationStateChanged(NavigationState change) => ();
};

interface NavigationController {
  LoadUrl(string url) => (bool ok, string error);
  GoBack();
  GoForward();
  Stop();
  Reload();
  GetVisibleEntry() => (NavigationState entry);
};
